// Encoder detent = one 16 ms mouse tick (tap-ms = 20), so per detent:
// cursor moves MOVE_VAL * 0.016 px, scroll moves SCRL_VAL * 0.016 wheel notches
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1250
#define ZMK_POINTING_DEFAULT_SCRL_VAL 70

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

// Constant cursor speed, no acceleration
&mmv {
    acceleration-exponent = <0>;
};

/ {
    behaviors {
        enc_mouse_y: enc_mouse_y {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
            tap-ms = <20>;
        };

        enc_mouse_x: enc_mouse_x {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
            tap-ms = <20>;
        };

        enc_scroll_y: enc_scroll_y {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        enc_scroll_x: enc_scroll_x {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
            tap-ms = <20>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&studio_unlock>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "base";
            sensor-bindings = <&enc_mouse_y &enc_mouse_x>;

// -------------------------------------------------------------------------------------------------
// |  ESC |  Q  |  W  |  E  |  R  |  T  |                    |  Y  |  U   |  I  |  O  |  P  | BKSP |
// |  TAB |  A  |  S  |  D  |  F  |  G  |                    |  H  |  J   |  K  |  L  |  ;  |  '   |
// |  ALT |  Z  |  X  |  C  |  V  |  B  |  LCLK  |  |  RCLK  |  N  |  M   |  ,  |  .  |  /  | ENT  |
//                    | GUI | CTRL| SHFT|                    | SPC | RSE  | LWR |
            bindings = <
&kp ESC  &kp Q &kp W &kp E    &kp R     &kp T                          &kp Y     &kp U &kp I     &kp O   &kp P    &kp BSPC
&kp TAB  &kp A &kp S &kp D    &kp F     &kp G                          &kp H     &kp J &kp K     &kp L   &kp SEMI &kp SQT
&kp LALT &kp Z &kp X &kp C    &kp V     &kp B     &mkp LCLK &mkp RCLK &kp N     &kp M &kp COMMA &kp DOT &kp FSLH &kp RET
                     &kp LGUI &kp LCTRL &kp LSHFT                      &kp SPACE &mo 2 &mo 1
            >;
        };

        lower_layer {
            display-name = "lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;

// ------------------------------------------------------------------------------------------------
// |      |  1  |  2  |  3  |  4  |  5  |                    |  6  |  7  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |                    | LFT | DWN |  UP | RGT |     |  F12 |
// | boot | F1  | F2  | F3  | F4  | F5  |  MUTE  |  |  boot  |  F6 | F7  | F8  | F9  | F10 |  F11 |
//                    |     |     |     |                    |     |     |     |
            bindings = <
&trans     &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0  &kp BSPC
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans  &kp F12
&bootloader &kp F1      &kp F2       &kp F3       &kp F4       &kp F5       &kp C_MUTE &bootloader &kp F6   &kp F7   &kp F8 &kp F9    &kp F10 &kp F11
                                     &trans       &trans       &trans                         &trans   &trans   &trans
            >;
        };

        raise_layer {
            display-name = "raise";
            sensor-bindings = <&enc_scroll_y &enc_scroll_x>;

// ------------------------------------------------------------------------------------------------
// |      |  !  |  @  |  #  |  $  |  %  |                    |  ^  |  &  |  *  |  (  |  )  | BKSP |
// |      |     |     |     |     |     |                    |  -  |  =  |  [  |  ]  |  \  |  `   |
// |      |     |     |     |     |     |  MCLK  |  |  MCLK  |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    |     |     |     |                    |     |     |     |
            bindings = <
&trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT                   &kp CARET &kp AMPS  &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC
&trans &trans   &trans &trans   &trans   &trans                      &kp MINUS &kp EQUAL &kp LBKT        &kp RBKT &kp BSLH &kp GRAVE
&trans &trans   &trans &trans   &trans   &trans    &mkp MCLK &mkp MCLK &kp UNDER &kp PLUS  &kp LBRC        &kp RBRC &kp PIPE &kp TILDE
                       &trans   &trans   &trans                      &trans    &trans    &trans
            >;
        };

        extra1 {
            display-name = "extra1";
            status = "reserved";
        };

        extra2 {
            display-name = "extra2";
            status = "reserved";
        };
    };
};
